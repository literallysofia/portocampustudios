---
/**
 * BookingButtons
 * Email (sky blue) + WhatsApp (green) buttons with a prefilled booking
 * message. Same colours on any background.
 * The WhatsApp number comes from src/config.ts.
 *
 * @prop lang - message language
 * @prop room - optional room name added to the message
 */
import Icon from './Icon.astro';
import { emailLink, whatsappLink } from '../lib/booking';
import { t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  room?: string;
}

const { lang, room } = Astro.props;
const tr = t(lang);
const whatsapp = whatsappLink(lang, { room });
---

<div class="booking-buttons" data-booking-buttons>
  <a class="button button--accent" href={emailLink(lang, { room })} data-booking-email>
    <Icon name="mail" />
    {tr('cta.email')}
  </a>
  <a class="button button--green" href={whatsapp} target="_blank" rel="noopener" data-booking-whatsapp>
    <Icon name="whatsapp" />
    {tr('cta.whatsapp')}
  </a>
</div>
