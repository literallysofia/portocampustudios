---
/**
 * Icon
 * The site's own icon set, drawn on a 48×48 grid with chunky round
 * strokes. Main shapes use currentColor; details use --icon-accent
 * (set by Sticker, defaults to the logo blue).
 *
 * Add an icon by adding an entry to `icons` below; content files
 * reference icons by these names (e.g. services `icon: wifi`).
 *
 * @prop name - icon name
 * @prop size - rendered size in CSS units (default 1.5rem)
 */

interface Props {
  name: string;
  size?: string;
  class?: string;
}

const { name, size = '1.5rem', class: className } = Astro.props;

const s = 'fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"';
const a = 'fill="none" stroke="var(--icon-accent, #46BAE9)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"';
const f = 'fill="currentColor"';
const fa = 'fill="var(--icon-accent, #46BAE9)"';

const icons: Record<string, string> = {
  // Services
  wifi: `<path ${s} d="M7 19a24 24 0 0 1 34 0M13 26a15 15 0 0 1 22 0M19 33a6.5 6.5 0 0 1 10 0"/><circle cx="24" cy="39.5" r="3.5" ${f}/>`,
  tv: `<rect x="6" y="10" width="36" height="25" rx="5" ${s}/><path ${a} d="M13 18h8"/><path ${s} d="M17 42h14"/>`,
  droplet: `<path ${f} d="M24 4.5S9.5 20.5 9.5 30a14.5 14.5 0 0 0 29 0C38.5 20.5 24 4.5 24 4.5z"/><path ${a} d="M16.5 30a7.5 7.5 0 0 0 5.5 7"/>`,
  bath: `<path ${s} d="M13 42V11a5 5 0 0 1 5-5h6a5 5 0 0 1 5 5v3"/><path ${fa} d="M21 14h17l-3.5 7H24.5z"/><path ${a} d="M27 28v3M32 28v5M37 28v3"/>`,
  kitchen: `<path ${f} d="M7 22h34v11a9 9 0 0 1-9 9H16a9 9 0 0 1-9-9z"/><path ${s} d="M3.5 22h41"/><path ${a} d="M17 6c-2 3 2 5 0 8M24 6c-2 3 2 5 0 8M31 6c-2 3 2 5 0 8"/>`,
  garden: `<circle cx="24" cy="17" r="12" ${f}/><path ${s} d="M24 24v18M14 42h20"/><path ${a} d="M24 31l-5-4M24 28l4-3"/>`,
  snowflake: `<path ${s} d="M24 5v38M7.5 14.5l33 19M7.5 33.5l33-19"/><path ${a} d="M18 7l6 5 6-5M18 41l6-5 6 5"/>`,
  sparkles: `<path ${f} d="M20 6l3.2 9.3L32.5 18l-9.3 3.2L20 30.5l-3.2-9.3L7.5 18l9.3-2.7z"/><path ${fa} d="M35 26l1.9 5.1 5.1 1.9-5.1 1.9L35 40l-1.9-5.1L28 33l5.1-1.9z"/>`,
  lock: `<rect x="9" y="21" width="30" height="21" rx="5" ${f}/><path ${s} d="M15.5 21v-5a8.5 8.5 0 0 1 17 0v5"/><path ${a} d="M24 29v5"/>`,
  // Transport
  metro: `<rect x="10" y="5" width="28" height="30" rx="7" ${s}/><path ${a} d="M10 21h28"/><circle cx="17" cy="28" r="2" ${f}/><circle cx="31" cy="28" r="2" ${f}/><path ${s} d="M15 43l4-8M33 43l-4-8"/>`,
  bus: `<rect x="8" y="6" width="32" height="31" rx="6" ${s}/><path ${a} d="M8 22h32M18 12h12"/><path ${s} d="M14 37v5M34 37v5"/><circle cx="15" cy="30" r="2" ${f}/><circle cx="33" cy="30" r="2" ${f}/>`,
  train: `<path ${s} d="M12 35V13a8 8 0 0 1 8-8h8a8 8 0 0 1 8 8v22z"/><path ${a} d="M12 20h24"/><path ${s} d="M16 43l3-8M32 43l-3-8"/><circle cx="24" cy="28" r="2.5" ${f}/>`,
  plane: `<path ${f} d="M21 5.5a3 3 0 0 1 6 0V18l15 9v5l-15-4.5V36l5 4v3.5L24 41l-8 2.5V40l5-4v-8.5L6 32v-5l15-9z"/>`,
  car: `<path ${s} d="M8 30v-6l4.5-11a4 4 0 0 1 3.7-2.5h15.6a4 4 0 0 1 3.7 2.5L40 24v6a4 4 0 0 1-4 4H12a4 4 0 0 1-4-4z"/><path ${a} d="M8 24h32"/><path ${s} d="M13 34v5M35 34v5"/>`,
  // Interface
  mail: `<rect x="5" y="10" width="38" height="28" rx="5" ${s}/><path ${s} d="M7 13l17 13 17-13"/>`,
  whatsapp: `<path ${s} d="M24 6a18 18 0 0 0-15.6 27L6 42l9.3-2.4A18 18 0 1 0 24 6z"/><path ${f} d="M17.5 15.5c-1.4 0-2.5 1.8-2.5 3.5 0 5.6 8.4 14 14 14 1.7 0 3.5-1.1 3.5-2.5v-2.8l-4.6-1.8-2 2.3c-2.4-1-4.7-3.3-5.7-5.7l2.3-2-1.8-4.6z"/>`,
  phone: `<path ${s} d="M17 6h-5a5 5 0 0 0-5 5c0 17 13 30 30 30a5 5 0 0 0 5-5v-5l-9-4-4 4c-5-2-9-6-11-11l4-4z"/>`,
  facebook: `<path ${s} d="M28 42V25h6l1-7h-7v-4c0-2 1-3 3-3h4V5h-6c-5 0-8 3-8 8v5h-5v7h5v17"/>`,
  pin: `<path ${f} d="M24 44S9 28.5 9 19a15 15 0 0 1 30 0c0 9.5-15 25-15 25z"/><circle cx="24" cy="19" r="5.5" fill="#FFFFFF"/>`,
  arrow: `<path ${s} d="M8 24h31M27 12l12 12-12 12"/>`,
  'arrow-up': `<path ${s} d="M24 40V9M12 21L24 9l12 12"/>`,
  'arrow-up-right': `<path ${s} d="M13 35l22-22M17 13h18v18"/>`,
  menu: `<path ${s} d="M7 15h34M7 24h34M7 33h22"/>`,
  close: `<path ${s} d="M11 11l26 26M37 11L11 37"/>`,
  plus: `<path ${s} d="M24 8v32M8 24h32"/>`,
  calendar: `<rect x="6" y="9" width="36" height="33" rx="5" ${s}/><path ${s} d="M6 19h36M16 5v8M32 5v8"/><path ${a} d="M15 28h4M22 28h4M29 28h4M15 35h4"/>`,
  // 404: a confused little house (white body, dot eyes, blush, wavy mouth)
  // with a "?" floating by the roof
  'home-question': `<path fill="#FFFFFF" d="M10 21v16a5 5 0 0 0 5 5h18a5 5 0 0 0 5-5V21L24 9z"/><path ${s} d="M5 24L24 8l19 16"/><path ${s} d="M10 20v17a5 5 0 0 0 5 5h18a5 5 0 0 0 5-5V20"/><circle cx="18.5" cy="28" r="2.4" ${f}/><circle cx="29.5" cy="28" r="2.4" ${f}/><ellipse cx="15.5" cy="33" rx="2.4" ry="1.5" fill="#F4A6B8"/><ellipse cx="32.5" cy="33" rx="2.4" ry="1.5" fill="#F4A6B8"/><path ${s} stroke-width="3" d="M19.5 36.5c1.5-1.2 3-1.2 4.5 0s3 1.2 4.5 0"/><path ${a} stroke-width="3.5" d="M36 4.5a3.2 3.2 0 1 1 4.4 3c-.8.4-1.2 1-1.2 1.8"/><circle cx="39.2" cy="14" r="1.9" ${fa}/>`,
};

const markup = icons[name];
if (!markup) throw new Error(`Icon "${name}" doesn't exist. Add it to src/components/Icon.astro.`);
---

<svg class={className} width={size} height={size} viewBox="0 0 48 48" aria-hidden="true" focusable="false" set:html={markup} />
