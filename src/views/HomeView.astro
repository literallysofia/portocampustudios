---
/**
 * HomeView
 * The home page, shared by every locale. Sections follow the order
 * students decide in: what and where → rooms → what's included →
 * location → the city → questions → book.
 */
import { Image } from 'astro:assets';
import Sticker from '../components/Sticker.astro';
import Icon from '../components/Icon.astro';
import RoomCard from '../components/RoomCard.astro';
import Map from '../components/Map.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { getLocaleEntry, getRooms } from '../lib/content';
import { path, t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const tr = t(lang);

const { data: home } = await getLocaleEntry('home', lang);
const { data: services } = await getLocaleEntry('services', lang);
const { data: location } = await getLocaleEntry('location', lang);
const { data: faq } = await getLocaleEntry('faq', lang);
const rooms = await getRooms(lang);

const heroWords = [...home.hero.title.split(' '), home.hero.accent];
const featuredFaq = faq.groups.flatMap((group) => group.items).filter((item) => item.featured);
// Metro, bus and airport are the ones students ask about first
const transportTeaser = location.transport.filter((item) => ['metro', 'bus', 'plane'].includes(item.icon));
---

<section class="hero container">
  <div class="hero__title-wrap">
    <h1 class="hero__title">
      {
        heroWords.map((word, i) => (
          <>
            <span class="hero__word-mask">
              <span class:list={['hero__word', i === heroWords.length - 1 && 'accent']} style={`--i:${i}`}>{word}</span>
            </span>{' '}
          </>
        ))
      }
    </h1>
  </div>
  <div class="hero__row">
    <p class="hero__subtitle">{home.hero.subtitle}</p>
    <div class="hero__actions" data-book-cta>
      <a class="button" href="#rooms">{tr('cta.seeRooms')}</a>
      <a class="button button--ghost" href={path(lang, 'book')}>{tr('cta.book')}</a>
    </div>
  </div>
  <div class="hero__media">
    <Image
      src={home.hero.image}
      alt={home.hero.imageAlt}
      widths={[640, 1024, 1440, 1920]}
      sizes="(max-width: 1400px) 94vw, 80rem"
      loading="eager"
      fetchpriority="high"
    />
    <ul class="hero__chips">
      {
        home.hero.chips.map((chip, i) => (
          <li class:list={['chip', i === home.hero.chips.length - 1 && 'chip--green']} style={`--i:${i}`}>
            {chip}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="intro container section" id="intro">
  <p class="intro__text" data-reveal>{home.intro.text}</p>
  <dl class="intro__facts">
    {
      home.intro.facts.map((fact) => (
        <div class="intro__fact" data-reveal>
          <dt class="intro__value">{fact.value}</dt>
          <dd class="intro__label">{fact.label}</dd>
        </div>
      ))
    }
  </dl>
  <div class="intro__photos">
    {
      home.intro.photos.map((photo, i) => (
        <figure class:list={['intro__photo', `intro__photo--${i + 1}`]} data-reveal>
          <Image src={photo.image} alt={photo.alt} widths={[480, 800, 1200, 1600]} sizes={i === 0 ? '(max-width: 768px) 92vw, 55vw' : '(max-width: 768px) 46vw, 28vw'} />
        </figure>
      ))
    }
  </div>
</section>

<section class="rooms container section" id="rooms" aria-labelledby="rooms-title">
  <header class="section-head" data-reveal>
    <p class="eyebrow">{home.rooms.eyebrow}</p>
    <h2 id="rooms-title">{home.rooms.title}</h2>
    {home.rooms.text && <p>{home.rooms.text}</p>}
  </header>
  <div class="rooms__grid">
    {rooms.map((room) => <RoomCard room={room} href={path(lang, 'room', room.data.urlSlug)} />)}
  </div>
</section>

<section class="services section" id="services" aria-labelledby="services-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <p class="eyebrow">{home.services.eyebrow}</p>
      <h2 id="services-title">{home.services.title}</h2>
      {home.services.text && <p>{home.services.text}</p>}
    </header>
    <ul class="services__grid">
      {
        services.items.map((item, i) => (
          <li class="service" data-reveal>
            <Sticker icon={item.icon} index={i} />
            <div>
              <h3 class="service__title">{item.title}</h3>
              <p class="service__text">{item.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="location-teaser container section" id="location" aria-labelledby="location-title">
  <div class="location-teaser__copy">
    <header class="section-head" data-reveal>
      <p class="eyebrow">{home.location.eyebrow}</p>
      <h2 id="location-title">{home.location.title}</h2>
      {home.location.text && <p>{home.location.text}</p>}
    </header>
    <ul class="transport-list">
      {
        transportTeaser.map((item, i) => (
          <li class="transport-list__item" data-reveal>
            <Sticker icon={item.icon} index={i + 1} size="2.75rem" />
            <div>
              <h3 class="transport-list__title">{item.title}</h3>
              <p class="transport-list__text">{item.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <a class="button button--ghost" href={path(lang, 'location')} data-reveal>
      {tr('cta.howToGetHere')}
      <Icon name="arrow" />
    </a>
  </div>
  <Map lang={lang} class="location-teaser__map" />
</section>

<section class="city section" aria-labelledby="city-title">
  <div class="container">
    <div class="city__banner" data-reveal>
      <Image src={home.city.image} alt={home.city.imageAlt} widths={[640, 1024, 1440, 1920]} sizes="(max-width: 1400px) 94vw, 80rem" />
      <div class="city__banner-copy">
        <p class="eyebrow">{home.city.eyebrow}</p>
        <h2 id="city-title">{home.city.title}</h2>
      </div>
    </div>
    <div class="city__intro">
      <p data-reveal>{home.city.text}</p>
    </div>
    <ul class="city__places" data-reveal>
      {
        location.places.items.slice(0, 8).map((place) => (
          <li>
            <a class="city__place" href={path(lang, 'location', undefined, 'places')}>
              {place.name}
            </a>
          </li>
        ))
      }
      <li>
        <a class="city__place city__place--more" href={path(lang, 'location', undefined, 'places')}>
          {tr('cta.more')}
          <Icon name="arrow" size="1em" />
        </a>
      </li>
    </ul>
  </div>
</section>

<section class="faq-teaser container section" aria-labelledby="faq-title">
  <header class="section-head faq-teaser__head" data-reveal>
    <p class="eyebrow">{home.faq.eyebrow}</p>
    <h2 id="faq-title">{home.faq.title}</h2>
    <a class="text-link" href={path(lang, 'faq')}>
      {tr('cta.allFaq')}
      <Icon name="arrow" size="1.1em" />
    </a>
  </header>
  <div data-reveal>
    <FaqList items={featuredFaq} />
  </div>
</section>

<CtaBand lang={lang} {...home.cta} />
